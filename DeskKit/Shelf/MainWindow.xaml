<Window x:Class="ShotShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShotShelf"
        xmlns:tk="clr-namespace:DeskKit.Transfer"
        Title="ShotShelf 截图暂存板"
        Width="980"
        SizeToContent="Height"
        MinWidth="520" MinHeight="150"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#F4F5F7">

    <!-- 2026-11-02 升级阶段1（用户要求）：去掉系统标题栏。
         WindowChrome 方案（不用 AllowsTransparency，避开透明+SizeToContent 的坑）：
         - CaptionHeight=0          → 没有标题栏拖动区（移动窗口改为"空白处拖动"，见 cs 的 OnRootMouseDown）
         - ResizeBorderThickness=6  → 窗口边缘 6px 仍是系统缩放边框，宽度/高度照常可拖
         - GlassFrameThickness=0    → 不要 Win10/11 的边框光影
         - UseAeroCaptionButtons=False → 不生成隐形的最小化/最大化/关闭按钮 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- ============================================================
         2026-10-26 十三次更新：
         ① 列表拆成上下两条水平轨道：上=图片行，下=文字行，各自横向排列（超出横向滚动），
            不再混在一起自动换行成网格；
         ② 卡片尺寸缩到原来的 2/3（172x166 → 115x111，缩略图区 160x120 → 107x80）；
         ③ 卡片样式/模板抽到 Window.Resources，两个列表共用一份。
         ============================================================ -->
    <Window.Resources>

        <!-- 行的排列方式：水平一行，绝不换行（换行由外层两条轨道负责） -->
        <ItemsPanelTemplate x:Key="RowItemsPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- 卡片容器：选中蓝边 / hover 灰边 / 拖动排序时的左右插入指示线 -->
        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <!-- 二十五次更新（恢复）：hover 放大的卡片要盖住左右邻居，抬高层级 -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="99"/>
                </Trigger>
                <!-- 2026-11-14：滚轮翻页选中的固定卡掀到叠堆最上（布局槽不动，仅抬层级）。
                     值必须高于 hover 的 99：滚轮操作时鼠标必然悬停在叠堆上，若只有 10 会被
                     当前 hover 卡(99)永远压住，出现"只有角标在换、卡片不换"的现象（已实测踩坑） -->
                <DataTrigger Binding="{Binding PinTop}" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100"/>
                </DataTrigger>
            </Style.Triggers>
            <!-- 2026-11-14 hover 哪张显示哪张：悬停固定卡即选中（掀到最上），见 OnCardMouseEnter -->
            <EventSetter Event="MouseEnter" Handler="OnCardMouseEnter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 二十二次更新：外留 10px 顶部 / 8px 左右余量，供 hover 放大时"长高"用，
                             这部分余量在列表项内部，不会被 ScrollViewer 裁掉（二十五次更新恢复）
                             2026-11-14：Margin 改绑定 CascadeMargin——固定卡级联叠放（被压卡负左边距露 13px 边缘） -->
                        <Grid Margin="{Binding CascadeMargin}">
                            <!-- 十四次更新: Padding 改 0，让图片能真正铺满整张卡片；
                                 圆角由图片分支自己的 Border.Background 保证
                                 二十五次更新（恢复）：hover 放大，原点(0.5,1) 以底边中点为轴往上长，
                                 注意不要给这个 Border 加 Effect/投影——会让文字放大时先糊后清 -->
                        <!-- 2026-11-02 UI 美化：卡片改圆角 8 + 细边框，选中=主色蓝 -->
                        <Border x:Name="Card" Background="White" BorderBrush="#E4E6EA"
                                BorderThickness="1" CornerRadius="8" Padding="0" Margin="5"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,1"
                                SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter/>
                            </Border>

                            <!-- 插入指示线：拖到本卡片左半边→左侧亮；右半边→右侧亮 -->
                            <Border x:Name="MarkLeft" Width="3" CornerRadius="2"
                                    Background="#2D7FF9"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Margin="1,10,0,10" Visibility="Collapsed"/>
                            <Border x:Name="MarkRight" Width="3" CornerRadius="2"
                                    Background="#2D7FF9"
                                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Margin="0,10,1,10" Visibility="Collapsed"/>

                            <!-- 2026-11-14 固定卡片叠放：数量角标。
                                 只绑在固定组顶卡（最近固定的）上、n≥2 才可见（数据层算好）；
                                 放左上角避开卡片自带的图钉图标（右上角）；
                                 根 Grid 不被 Card 的 ClipToBounds 裁剪，后绘制自动盖在卡上；
                                 IsHitTestVisible=False 不挡图钉/卡片点击 -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="3,3,0,0" CornerRadius="8" MinWidth="16" Height="16"
                                    Background="#F97316" Padding="3,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding PinBadgeVisibility}">
                                <TextBlock Text="{Binding PinBadgeText}" FontSize="10" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#1E88E5"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#C9CDD4"/>
                                <!-- 二十五次更新（恢复）：hover 放大，130ms 缓出；不加投影（投影会把文字先栅格化再放大） -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 插入位置提示（绑定本容器的附加属性，由拖拽代码设置） -->
                            <DataTrigger Value="Left"
                                         Binding="{Binding Path=(local:DragHint.InsertSide),
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                <Setter TargetName="MarkLeft" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Value="Right"
                                         Binding="{Binding Path=(local:DragHint.InsertSide),
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                <Setter TargetName="MarkRight" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2026-11-04 图标统一：原三个自绘彩色 DrawingImage（IconSave/IconCopy/IconDelete，16×16 手绘软盘/剪贴板/垃圾桶）
             已弃用删除 → 卡片悬浮三按钮改用 Material Symbols Rounded 矢量 Path（见下方 CardTemplate），
             与全程序图标同一系列（同源 SVG 路径数据，DeskKit.Icons）。 -->

        <!-- 单张卡片内容：图片分支 / 文字分支 + 右上角图钉 + hover 工具条
             十四次更新：
               ① 图片分支改为"缩略图铺满整张卡片"（Border.Background 用 ImageBrush，
                  圆角自动裁剪），图片大小与时间直接压在图片底部（半透明黑条 + 白字）；
               ② 文字分支字号加大（预览 7.5→9.5，信息行 9→9.5），内边距改成自己留。 -->
        <DataTemplate x:Key="CardTemplate">
            <!-- 尺寸按 2/3 缩小（原 172x166）；图钉靠右上角定位，故用固定尺寸 Grid -->
            <!-- 右键（2026-11-11）：发送到已连接设备；ContextMenuOpening 里动态建菜单并 e.Handled 阻止冒泡到主窗菜单 -->
            <Grid Width="115" Height="111" ContextMenuOpening="OnCardContextMenuOpening">
                <!-- ===== 图片分支：2026-11-14 用户要求恢复"十四次更新"设计——缩略图铺满整张卡片
                     （ImageBrush UniformToFill 裁切铺满，圆角自动裁剪），
                     尺寸/时间信息改为底部半透明黑条浮在图上（白字）。 -->
                <Border CornerRadius="8" ClipToBounds="True"
                        Visibility="{Binding ImageVisibility}">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                        </Border>
                        <!-- 底部信息浮层：半透明黑条 + 白字（十四次更新同款） -->
                        <Border VerticalAlignment="Bottom" Background="#99000000" Padding="6,3">
                            <StackPanel>
                                <TextBlock Text="{Binding SizeText}" FontSize="10"
                                           Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TimeText}" FontSize="9"
                                           Foreground="#E6FFFFFF" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== 文字分支：浅纸色底 + 文字预览（2026-11-02 UI 美化：信息字色统一中性灰） ===== -->
                <StackPanel Margin="6,4,6,6" Visibility="{Binding TextVisibility}">
                    <!-- 文字块高度 78→74：给变大的字号和行距让位，保证下面两行信息仍在卡片内 -->
                    <Border Width="107" Height="74" Background="#FBFBF8"
                            BorderBrush="#E3E3DC" BorderThickness="1" CornerRadius="4"
                            Padding="4,3" ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TextPreview}"
                                   FontSize="10.5" LineHeight="14"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{Binding SizeText}" Foreground="#333333" FontSize="10"
                               FontWeight="SemiBold" Margin="2,3,0,0"/>
                    <TextBlock Text="{Binding TimeText}" Foreground="#8A8F98" FontSize="9" Margin="2,1,0,0"/>
                </StackPanel>

                <!-- 右上角图钉: hover 卡片时出现; 已固定的恒显
                     图标用 Segoe Fluent Icons / Segoe MDL2 Assets 的 E840 字形，
                     单色字形，Foreground 绑 PinColor：未固定=灰，已固定=橙。
                     十九次更新：字号 11 → 16（图标明显变大）。 -->
                <Button PreviewMouseLeftButtonDown="PinButton_PreviewMouseDown"
                        ToolTip="{Binding PinToolTip}"
                        Cursor="Hand" Focusable="False"
                        Background="Transparent" BorderThickness="0" Padding="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,1,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- 白色描边（叠一层偏移的白色字形）让图标在任何底色的图上都看得清 -->
                    <Grid>
                        <TextBlock Text="&#xE840;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#FFFFFF" Opacity="0.85"
                                   Margin="1,1,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE840;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{Binding PinColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- hover 悬浮工具条: 保存/复制/删除（鼠标进入卡片任意位置即显示）
                     十九次更新：挪到卡片正中，按钮放大，底下垫一层半透明白底保证图标清晰
                     二十次更新：正中不好看 → 下移到卡片下方 1/3 处（距底 24px，正好在信息条上方）；
                                 图标由 emoji 改成自绘彩色矢量图（WPF 不支持彩色 emoji 字形）
                     2026-11-02 反馈：还是贴着卡片底边放（距底 4px） -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,4"
                        CornerRadius="5" Background="#E8FFFFFF" Padding="3,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal">
                        <!-- 2026-11-04 图标统一：自绘彩色 DrawingImage → Material Symbols Rounded 矢量 Path
                             （与程序其他图标同一系列；Stretch=Uniform 自动适配，Path 数据来自 DeskKit.Icons 同源 SVG） -->
                        <Button ToolTip="另存为文件（图片 PNG / 文本 TXT）" PreviewMouseLeftButtonDown="CardSave_PreviewMouseDown"
                                Padding="4,1" Margin="1,0" Cursor="Hand" Focusable="False"
                                Background="#F0F0F0" BorderThickness="0">
                            <Path Data="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h447q16 0 30.5 6t25.5 17l114 114q11 11 17 25.5t6 30.5v447q0 33-23.5 56.5T760-120H200Zm560-526L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM280-560h280q17 0 28.5-11.5T600-600v-80q0-17-11.5-28.5T560-720H280q-17 0-28.5 11.5T240-680v80q0 17 11.5 28.5T280-560Zm-80-86v446-560 114Z"
                                  Stretch="Uniform" Width="16" Height="16" Fill="#444A52"/>
                        </Button>
                        <Button ToolTip="复制到剪贴板" PreviewMouseLeftButtonDown="CardCopy_PreviewMouseDown"
                                Padding="4,1" Margin="1,0" Cursor="Hand" Focusable="False"
                                Background="#F0F0F0" BorderThickness="0">
                            <Path Data="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-520q0-17 11.5-28.5T160-720q17 0 28.5 11.5T200-680v520h400q17 0 28.5 11.5T640-120q0 17-11.5 28.5T600-80H200Zm160-240v-480 480Z"
                                  Stretch="Uniform" Width="16" Height="16" Fill="#444A52"/>
                        </Button>
                        <Button ToolTip="删除" PreviewMouseLeftButtonDown="CardDelete_PreviewMouseDown"
                                Padding="4,1" Margin="1,0" Cursor="Hand" Focusable="False"
                                Background="#F0F0F0" BorderThickness="0">
                            <Path Data="M280-120q-33 0-56.5-23.5T200-200v-520q-17 0-28.5-11.5T160-760q0-17 11.5-28.5T200-800h160q0-17 11.5-28.5T400-840h160q17 0 28.5 11.5T600-800h160q17 0 28.5 11.5T800-760q0 17-11.5 28.5T760-720v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM400-280q17 0 28.5-11.5T440-320v-280q0-17-11.5-28.5T400-640q-17 0-28.5 11.5T360-600v280q0 17 11.5 28.5T400-280Zm160 0q17 0 28.5-11.5T600-320v-280q0-17-11.5-28.5T560-640q-17 0-28.5 11.5T520-600v280q0 17 11.5 28.5T560-280ZM280-720v520-520Z"
                                  Stretch="Uniform" Width="16" Height="16" Fill="#444A52"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 空行提示的统一样式：列表没内容时在行中间显示一句淡灰小字 -->
        <Style x:Key="EmptyHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- ============================================================
             2026-11-02 升级阶段2：左侧竖排标签样式
             2026-11-02 反馈二修：不再显示"图/文"文字（窄条里看不清），改用颜色区分：
               图签=橙色 TabImageBrush / 文签=蓝绿色 TabTextBrush；
             2026-11-02 反馈三修：选中/未选中不好区分 → 未选中一律中性浅灰，
               选中才显示本签颜色（橙/蓝绿实色），对比强烈一眼可辨。
             两个标签各占标签列一半高度铺满（外层 Grid 两行 *）。
             ============================================================ -->
        <SolidColorBrush x:Key="TabImageBrush" Color="#F28C28"/> <!-- 图：橙 -->
        <SolidColorBrush x:Key="TabTextBrush" Color="#1FA9A0"/>  <!-- 文：蓝绿 -->
        <SolidColorBrush x:Key="TabDeviceBrush" Color="#5C6BC0"/> <!-- 设备：靛蓝（2026-11-10 局域网传输，与橙/蓝绿同饱和度档位） -->

        <Style x:Key="SideTab" TargetType="RadioButton">
            <!-- 不设 Width/Height：由外层两行 Grid 拉伸铺满各自一半 -->
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="{StaticResource TabImageBrush}"/> <!-- 实例上覆盖 -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- 选中=实例 Background（橙/蓝绿）；未选中由触发器覆盖为中性灰 -->
                        <Border x:Name="TabBg" Background="{TemplateBinding Background}"
                                CornerRadius="5" SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <!-- 未选中：中性浅灰（与选中的彩色形成强对比） -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="TabBg" Property="Background" Value="#DFE3E8"/>
                            </Trigger>
                            <!-- 未选中 hover：灰色加深一点，提示可点 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBg" Property="Background" Value="#C9CFD7"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 2026-11-10 局域网文件传输：设备卡 ============ -->
        <!-- 容器：无选中/hover 放大效果（设备卡不需要，系统 DragDrop 视觉即可） -->
        <Style x:Key="DeviceContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Margin="0,4,0,0" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备卡：Material 图标(computer/smartphone) + 名称 + IP + 在线点 + 状态行。
             2026-11-10 反馈：去掉齿轮，整卡可点；2026-11-12 反馈：点卡=聊天窗口（程序之间也是聊天窗），
             仅本机卡（Id=deskkit）= 齿轮 + 传输设置 -->
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type tk:DeviceItem}">
            <Grid Width="150" Height="92" Margin="2">
                <Border x:Name="CardBorder" Background="White" BorderBrush="#E4E6EA" BorderThickness="1"
                        CornerRadius="8" Padding="8,7" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnDeviceCardClick"
                        ToolTip="点击打开聊天窗口（可发文字/图片/文件）">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <Path x:Name="IcoPc" Fill="#444A52" Width="19" Height="19" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Data="M20,18c1.1,0,2-0.9,2-2V6c0-1.1-0.9-2-2-2H4C2.9,4,2,4.9,2,6v10c0,1.1,0.9,2,2,2H0v2h24v-2H20z M4,6h16v10H4V6z"/>
                            <Path x:Name="IcoPhone" Fill="#444A52" Width="19" Height="19" Stretch="Uniform"
                                  VerticalAlignment="Center" Visibility="Collapsed"
                                  Data="M17,1.01L7,1C5.9,1,5,1.9,5,3v18c0,1.1,0.9,2,2,2h10c1.1,0,2-0.9,2-2V3C19,1.9,18.1,1.01,17,1.01z M17,19H7V5h10V19z"/>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#33383F"
                                       Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="84"
                                       TextTrimming="CharacterEllipsis"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="5,0,0,0" Fill="#B8B8B8"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 2026-11-10 Tailscale：双 IP 时换行显示（卡高 92 已核算放得下） -->
                        <TextBlock Grid.Row="1" Text="{Binding Ip}" FontSize="10" Foreground="#7A828C"
                                   Margin="25,3,0,0" TextWrapping="Wrap"/>
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#1E88E5"
                                       Margin="25,0,0,0" VerticalAlignment="Center" MaxWidth="90"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <!-- 2026-11-10 文字互发：右下角 💬 小按钮；2026-11-11 反馈：点击改为弹简易聊天窗 -->
                        <Border x:Name="BtnMsg" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Width="20" Height="20" CornerRadius="10" Background="#EEF1FB" Cursor="Hand"
                                ToolTip="聊天">
                            <TextBlock Text="💬" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Border>
                        <Border x:Name="BtnGear" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Width="20" Height="20" CornerRadius="10" Background="#EEF1FB" Cursor="Hand"
                                ToolTip="传输设置" Visibility="Collapsed">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5"
                                       Foreground="#444A52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="phone">
                    <Setter TargetName="IcoPc" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IcoPhone" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 本机伪设备（Id=deskkit）：整卡点击=传输设置；右下角按钮换齿轮（💬 隐藏）。
                     注意按 Id 而非 Type 区分——远端 DeskKit 程序的卡 type 也是 deskkit，
                     但它是聊天对象，不能给齿轮（2026-11-12 反馈） -->
                <DataTrigger Binding="{Binding Id}" Value="deskkit">
                    <Setter TargetName="CardBorder" Property="ToolTip" Value="点击打开传输设置"/>
                    <Setter TargetName="BtnMsg" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BtnGear" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="#4CAF50"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 2026-11-02 升级阶段1：根 Grid 挂窗口级右键菜单（原工具栏 5 个按钮全部并入）+
         MouseLeftButtonDown（空白处拖动窗口，cs 里 OnRootMouseDown 做命中检测）。
         2026-11-02 升级阶段2：x:Name="RootGrid" —— 拖动排序的插入指示线 Adorner
         以它为坐标原点宿主（见 DragFeedback.cs 的 InsertCaretAdorner）。 -->
    <Grid x:Name="RootGrid" MouseLeftButtonDown="OnRootMouseDown">
        <Grid.ContextMenu>
            <!-- 2026-11-12 统一菜单：与托盘右键同一套条目（仅少一条"显示暂存架"） -->
            <ContextMenu Opened="OnWindowMenuOpened">
                <!-- 2026-11-12 按功能分组：截图 / 暂存架窗口 / 功能开关 / 程序配置 / 帮助关于 / 退出 -->
                <MenuItem x:Name="MenuCapture" Header="区域/窗口截图" InputGestureText="F1" Click="MenuCapture_Click"
                          ToolTip="区域截图，截图自动进入暂存架"/>
                <MenuItem x:Name="MenuFull" Header="全屏截到剪贴板" InputGestureText="Ctrl+Shift+C" Click="MenuFull_Click"/>
                <MenuItem x:Name="MenuPin" Header="剪贴板内容贴图" InputGestureText="Ctrl+Alt+V" Click="MenuPin_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuClear" Header="清空图片" Click="MenuClear_Click"/>
                <MenuItem x:Name="MenuOpenDir" Header="打开保存目录" Click="MenuOpenDir_Click"/>
                <MenuItem x:Name="MenuTopmost" Header="窗口置顶" IsCheckable="True" Click="MenuTopmost_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuQuickG" Header="快捷跳转" IsCheckable="True" Click="MenuQuickG_Click"
                          ToolTip="任意程序里按 Ctrl+G 搜索并点击目标对话框按钮"/>
                <MenuItem x:Name="MenuLan" Header="网络传输" IsCheckable="True" Click="MenuLan_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSettings" Header="设置…" Click="MenuSettings_Click"
                          ToolTip="外观 / 暂存 / 贴边 / 快捷键 / 传输等设置"/>
                <MenuItem x:Name="MenuAutoStart" Header="开机自启" IsCheckable="True" Click="MenuAutoStart_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuHelp" Header="帮助" Click="MenuHelp_Click"
                          ToolTip="打开帮助文档（程序目录 Help.md，可随时编辑更新）"/>
                <MenuItem x:Name="MenuAbout" Header="关于 DeskKit…" Click="MenuAbout_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="退出" Click="MenuExit_Click"
                          ToolTip="彻底退出程序（含系统托盘图标）"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <!-- 行0: 左侧竖排标签列 + 单轨道内容区（2026-11-02 升级阶段2：
                 原"图片/文字上下两条轨道"改为"标签切换 + 单轨道"，高度收窄一半） -->
            <RowDefinition Height="*"/>
            <!-- 2026-11-02 反馈：状态栏行已移除 -->
        </Grid.RowDefinitions>

        <!-- ============ 行0: 标签列 + 单轨道内容区（升级阶段2 改造） ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 左列：竖排标签条（固定 28px，想调宽度改这里） -->
                <ColumnDefinition Width="28"/>
                <!-- 右列：单轨道内容区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：竖排标签条（2026-11-02 UI 美化：去灰底/分隔线，色块圆角与背景融合；
                 2026-11-10 起三行平分：橙=图 / 蓝绿=文 / 靛蓝=设备传输） ===== -->
            <Border Grid.Column="0" Background="Transparent">
                <Grid Margin="3,6,2,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="TabImage" Grid.Row="0" GroupName="ShelfTab" IsChecked="True"
                                 ToolTip="图片"
                                 Background="{DynamicResource TabImageBrush}"
                                 Style="{StaticResource SideTab}"
                                 Checked="OnTabImage_Checked"/>
                    <RadioButton x:Name="TabText" Grid.Row="1" GroupName="ShelfTab"
                                 ToolTip="文字"
                                 Background="{DynamicResource TabTextBrush}"
                                 Style="{StaticResource SideTab}"
                                 Checked="OnTabText_Checked"/>
                    <RadioButton x:Name="TabDevices" Grid.Row="2" GroupName="ShelfTab"
                                 ToolTip="设备传输"
                                 Background="{DynamicResource TabDeviceBrush}"
                                 Style="{StaticResource SideTab}"
                                 Checked="OnTabDevices_Checked"/>
                </Grid>
            </Border>

            <!-- ===== 右：单轨道内容区 =====
                 两条轨道 Border 重叠在同一格（不设 Grid.Row 即同格），靠 Visibility 互斥；
                 列表控件/数据源/卡片模板/拖拽排序逻辑零改动。
                 注意：ContentGrid 高度 = 窗口内容区高度（窗口 MinHeight=240 兜底，
                 卡片行不满一屏时下方留白，换来高度固定可贴边——阶段3需要）。 -->
            <Grid Grid.Column="1" Margin="2,4,4,4">
                <!-- 图片轨道（默认显示）；2026-11-02 UI 美化：去轨道边框，融入窗口底色 -->
                <Border x:Name="PnlImageTrack" Background="Transparent" MinHeight="46">
                    <Grid>
                        <ListBox x:Name="LstShots"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,1"
                                 VerticalAlignment="Center"
                                 AllowDrop="True"
                                 ItemsPanel="{StaticResource RowItemsPanel}"
                                 ItemContainerStyle="{StaticResource CardContainerStyle}"
                                 ItemTemplate="{StaticResource CardTemplate}"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="OnListClick"
                                 SelectionChanged="OnListSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseWheel="OnListPreviewMouseWheel"
                                 DragOver="OnListDragOver"
                                 DragLeave="OnListDragLeave"
                                 Drop="OnListDrop"/>
                        <TextBlock Text="暂无图片 · 截图后自动出现在这里">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHintStyle}">
                                    <Style.Triggers>
                                        <!-- 有内容时把提示藏起来 -->
                                        <DataTrigger Binding="{Binding HasItems, ElementName=LstShots}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 文字轨道（默认隐藏，与图片轨道同格互斥） -->
                <Border x:Name="PnlTextTrack" Background="Transparent" MinHeight="46"
                        Visibility="Collapsed">
                    <Grid>
                        <ListBox x:Name="LstTexts"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,1"
                                 AllowDrop="True"
                                 ItemsPanel="{StaticResource RowItemsPanel}"
                                 ItemContainerStyle="{StaticResource CardContainerStyle}"
                                 ItemTemplate="{StaticResource CardTemplate}"
                                 VerticalAlignment="Center"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="OnListClick"
                                 SelectionChanged="OnListSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                 PreviewMouseMove="OnListPreviewMouseMove"
                                 PreviewMouseWheel="OnListPreviewMouseWheel"
                                 DragOver="OnListDragOver"
                                 DragLeave="OnListDragLeave"
                                 Drop="OnListDrop"/>
                        <TextBlock Text="暂无文字 · 复制一段文字后自动出现在这里">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHintStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=LstTexts}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 设备轨道（2026-11-10 局域网文件传输：默认隐藏，与图/文轨道同格互斥）。
                     拖资源管理器文件到设备卡=发送；点💬=弹文字输入窗；
                     2026-11-10 文字互发：收到的文字直接入"文"标签，设备页不再放消息条 -->
                <Border x:Name="PnlDeviceTrack" Background="Transparent" MinHeight="46"
                        Visibility="Collapsed">
                    <Grid>
                        <ListBox x:Name="LstDevices"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,1"
                                 VerticalAlignment="Center"
                                 AllowDrop="True"
                                 ItemsPanel="{StaticResource RowItemsPanel}"
                                 ItemContainerStyle="{StaticResource DeviceContainerStyle}"
                                 ItemTemplate="{StaticResource DeviceCardTemplate}"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 DragOver="OnDeviceDragOver"
                                 DragLeave="OnListDragLeave"
                                 Drop="OnDeviceDrop"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 行0: 工具栏（2026-11-02 升级阶段1 移入右键菜单，原块注释保留） ============ -->
        <!--
        <Grid Grid.Row="0" Margin="8,6,8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,-6,0">
                <Button x:Name="BtnCapture" Content="📷 截图" Style="{StaticResource ToolButton}"
                        Click="BtnCapture_Click" ToolTip="区域截图（等同 F1），截图自动进入暂存架"/>
                <Button x:Name="BtnClear" Content="清空全部" Style="{StaticResource ToolButton}" Click="BtnClear_Click"/>
                <Button x:Name="BtnSetAutoSaveDir" Content="📁 设置目录" Style="{StaticResource ToolButton}"
                        Click="BtnSetAutoSaveDir_Click"
                        ToolTip="选择自动保存文件夹（对话框会定位到当前目录）"/>
                <Button x:Name="BtnTopmost" Content="📍 置顶" Style="{StaticResource ToolButton}"
                        Click="BtnTopmost_Click" ToolTip="让本窗口始终显示在最前面"/>
            </StackPanel>
            <Button x:Name="BtnExit" Content="⏻ 退出" Style="{StaticResource ToolButton}"
                    Margin="0" HorizontalAlignment="Right"
                    Click="BtnExit_Click" ToolTip="彻底退出程序（含系统托盘图标）"/>
        </Grid>
        -->


        <!-- 2026-11-02 反馈：状态栏已移除（UpdateStatus 只写日志） -->

        <!-- 贴边隐藏时的"彩色小边"（2026-11-10 反馈）：三段=图/文/设备三标签色，
             Left/Right 贴边用竖条，Top 贴边用横条；显隐与方向由 UpdatePeekStrip 控制；
             IsHitTestVisible=False 不挡鼠标弹出判定 -->
        <Grid x:Name="PeekStrip" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid x:Name="PeekVert" Width="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Fill="{DynamicResource TabImageBrush}"/>
                <Rectangle Grid.Row="1" Fill="{DynamicResource TabTextBrush}"/>
                <Rectangle Grid.Row="2" Fill="{DynamicResource TabDeviceBrush}"/>
            </Grid>
            <Grid x:Name="PeekHorz" Height="8" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="{DynamicResource TabImageBrush}"/>
                <Rectangle Grid.Column="1" Fill="{DynamicResource TabTextBrush}"/>
                <Rectangle Grid.Column="2" Fill="{DynamicResource TabDeviceBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
