<Application x:Class="DeskKit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
      DeskKit 胶水 App：
      - 不设 StartupUri：暂存架窗口启动时只创建不显示（托盘常驻）
      - ShutdownMode=OnExplicitShutdown：窗口藏起来不算退出，必须显式 Shutdown
    -->
    <Application.Resources>
        <!-- 来自 ShotShelf App.xaml 的全局样式（暂存架窗口的 XAML 引用它们） -->

        <!-- ============================================================
             2026-11-02 UI 美化：全局色板（想换主题色只改这一块）
             浅色简洁风：浅灰窗底 + 白卡片 + 蓝主色 + 中性灰文字
             ============================================================ -->
        <SolidColorBrush x:Key="UiWindowBg" Color="#F4F5F7"/>   <!-- 窗口/标签列底 -->
        <SolidColorBrush x:Key="UiCardBg" Color="#FFFFFF"/>     <!-- 卡片白 -->
        <SolidColorBrush x:Key="UiHairline" Color="#E4E6EA"/>   <!-- 细边框 -->
        <SolidColorBrush x:Key="UiAccent" Color="#1E88E5"/>     <!-- 主色蓝 -->
        <SolidColorBrush x:Key="UiAccentHover" Color="#1976D2"/><!-- 主色蓝 hover -->
        <SolidColorBrush x:Key="UiTextPrimary" Color="#333333"/><!-- 主文字 -->
        <SolidColorBrush x:Key="UiTextMuted" Color="#8A8F98"/>  <!-- 次要文字 -->

        <!-- 2026-11-13 tooltip 统一显示在目标上方，避免盖住下方内容（菜单条目/工具栏按钮等） -->
        <Style TargetType="ToolTip">
            <Setter Property="Placement" Value="Top"/>
        </Style>

        <!-- 普通扁平按钮：白底细边、圆角、hover 浅灰（预览窗底部栏用） -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource UiTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEEF1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：蓝底白字（复制等主动作用） -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="{StaticResource UiAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮样式 -->
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 缩略图卡片样式 -->
        <Style x:Key="ShotCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- ============================================================
             2026-11-12 右键菜单现代化：与程序浅色圆角风格统一
             白底圆角 + 柔和阴影 + 浅蓝 hover + 蓝色勾选点，替换系统默认灰菜单
             ============================================================ -->

        <!-- 菜单容器：白底、10px 圆角、细边框、柔和投影（外圈 Grid 留出阴影空间） -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="14">
                            <Border Background="#FFFFFF"
                                    BorderBrush="{StaticResource UiHairline}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="290"
                                                      Opacity="0.22" Color="#22303C"/>
                                </Border.Effect>
                                <ItemsPresenter SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单条目：左勾选列 + 标题 + 快捷键；hover 浅蓝圆角高亮 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource UiTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="6" Padding="8,7" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27"/>  <!-- 图标/勾选列（含右侧间距） -->
                                    <ColumnDefinition Width="*"/>   <!-- 标题 -->
                                    <ColumnDefinition Width="Auto"/><!-- 快捷键 -->
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0,8,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           FontSize="11.5" Margin="18,0,0,0"
                                           Foreground="{StaticResource UiTextMuted}"
                                           VerticalAlignment="Center"/>
                                <!-- 勾选态：右侧蓝色小对勾（图标始终保留在左侧） -->
                                <TextBlock x:Name="Check" Grid.Column="2" Text="✓" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource UiAccent}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                                           Visibility="Collapsed"/>
                                <!-- 子菜单箭头：有子项时显示 -->
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource UiTextMuted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <!-- 2026-11-15 修复：原模板缺子菜单弹层（PART_Popup），带子项的菜单永远展不开 -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right" HorizontalOffset="-8" VerticalOffset="-8">
                            <Grid Margin="14">
                                <Border Background="#FFFFFF"
                                        BorderBrush="{StaticResource UiHairline}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="290"
                                                          Opacity="0.22" Color="#22303C"/>
                                    </Border.Effect>
                                    <ItemsPresenter SnapsToDevicePixels="True"/>
                                </Border>
                            </Grid>
                        </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 勾选态只在右侧显示对勾，左侧图标不被替换 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F1FB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <!-- 有子项：右侧显示 ›；顶级条目子菜单向下弹，次级条目向右弹 -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单分隔线：极浅灰 1px，两侧留白（覆盖菜单默认分隔样式） -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="#EDEFF2"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}"
                                Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
